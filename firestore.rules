rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all safety net for all unspecified collections and paths
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Hardened Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Admin privilege is strictly derived from /admins/{uid} or the verified bootstrap admin email.
    // Never derived from client-supplied custom auth claims.
    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'arhamrajpoot2122@gmail.com'
      );
    }

    // Student role is derived from a provisioned /users/{uid} record with role == 'student'.
    function isStudent() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }

    function isStudentOrAdmin() {
      return isAdmin() || isStudent();
    }

    // --- Validation Blueprints (Schema & Boundary Enforcement) ---
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'courseOrSubject', 'studyPreferences',
          'accessibilityPreferences', 'role', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 60
        && (!('courseOrSubject' in data) || (data.courseOrSubject is string && data.courseOrSubject.size() <= 80))
        && (!('accessibilityPreferences' in data) || (data.accessibilityPreferences is string && data.accessibilityPreferences.size() <= 200))
        && (!('studyPreferences' in data) || (
          data.studyPreferences is list && data.studyPreferences.size() <= 8 &&
          (data.studyPreferences.size() == 0 || (data.studyPreferences[0] is string && data.studyPreferences[0].size() <= 40))
        ))
        && data.role == 'student'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLocation(data) {
      return data.keys().hasAll(['id', 'name', 'accessLevel', 'description', 'accessibilityInfo', 'accessibilityVerified', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'accessLevel', 'description', 'accessibilityInfo', 'accessibilityVerified', 'openingHoursNote', 'updatedAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.accessLevel in [
          'Public & Student Access',
          'Student & Staff Card Access',
          'Restricted / Research Access',
          'Event / Controlled Access'
        ]
        && data.description is string && data.description.size() >= 10 && data.description.size() <= 600
        && data.accessibilityInfo is string && data.accessibilityInfo.size() >= 4 && data.accessibilityInfo.size() <= 500
        && data.accessibilityVerified is bool
        && (!('openingHoursNote' in data) || (data.openingHoursNote is string && data.openingHoursNote.size() <= 200))
        && data.updatedAt is timestamp;
    }

    function isValidQrCode(data) {
      return data.keys().hasAll(['id', 'locationId', 'locationName', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'locationId', 'locationName', 'active', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.locationId)
        && data.locationName is string && data.locationName.size() >= 2 && data.locationName.size() <= 120
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudySpaceOccupancy(data) {
      return data.keys().hasAll(['locationId', 'occupancy', 'activeCheckIns', 'lastReporterPseudonym', 'updatedAt'])
        && data.keys().hasOnly(['locationId', 'occupancy', 'activeCheckIns', 'lastReporterPseudonym', 'updatedAt'])
        && isValidId(data.locationId)
        && data.occupancy in ['Low', 'Medium', 'Busy', 'Unknown']
        && data.activeCheckIns is int && data.activeCheckIns >= 0 && data.activeCheckIns <= 5000
        && data.lastReporterPseudonym is string && data.lastReporterPseudonym.size() >= 2 && data.lastReporterPseudonym.size() <= 60
        && data.updatedAt is timestamp;
    }

    function isValidOccupancyReport(data) {
      return data.keys().hasAll(['locationId', 'userId', 'level', 'pseudonym', 'createdAt'])
        && data.keys().hasOnly(['locationId', 'userId', 'level', 'pseudonym', 'createdAt'])
        && isValidId(data.locationId)
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.level in ['Low', 'Medium', 'Busy']
        && data.pseudonym is string && data.pseudonym.size() >= 2 && data.pseudonym.size() <= 60
        && data.createdAt is timestamp;
    }

    function isValidCheckInSession(data) {
      return data.keys().hasAll(['userId', 'locationId', 'locationName', 'qrCodeId', 'status', 'checkedInAt'])
        && data.keys().hasOnly(['userId', 'locationId', 'locationName', 'qrCodeId', 'status', 'checkedInAt', 'checkedOutAt'])
        && isValidId(data.userId)
        && isValidId(data.locationId)
        && data.locationName is string && data.locationName.size() >= 2 && data.locationName.size() <= 120
        && isValidId(data.qrCodeId)
        && data.status in ['active', 'completed']
        && data.checkedInAt is timestamp
        && (!('checkedOutAt' in data) || data.checkedOutAt == null || data.checkedOutAt is timestamp);
    }

    function isValidFacilityReport(data) {
      return data.keys().hasAll(['userId', 'locationId', 'locationName', 'category', 'description', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'locationId', 'locationName', 'category', 'description', 'status', 'adminNotes', 'createdAt', 'updatedAt'])
        && isValidId(data.userId)
        && isValidId(data.locationId)
        && data.locationName is string && data.locationName.size() >= 2 && data.locationName.size() <= 120
        && data.category in [
          'Broken equipment',
          'Damaged furniture',
          'Faulty sockets',
          'Cleanliness concerns',
          'Accessibility obstacles',
          'Incorrect facility information'
        ]
        && data.description is string && data.description.size() >= 10 && data.description.size() <= 1000
        && data.status in ['Submitted', 'Under review', 'Resolved', 'Rejected']
        && (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 400))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCommunityItem(data) {
      return data.keys().hasAll(['kind', 'title', 'body', 'authorId', 'authorName', 'moderationStatus', 'flaggedCount', 'createdAt'])
        && data.keys().hasOnly([
          'kind', 'title', 'body', 'locationId', 'locationName', 'startsAt',
          'authorId', 'authorName', 'isDemoData', 'moderationStatus',
          'flaggedCount', 'participantsCount', 'createdAt'
        ])
        && data.kind in ['event', 'announcement', 'study-group', 'recommendation']
        && data.title is string && data.title.size() >= 4 && data.title.size() <= 120
        && data.body is string && data.body.size() >= 10 && data.body.size() <= 800
        && (!('locationId' in data) || isValidId(data.locationId))
        && (!('locationName' in data) || (data.locationName is string && data.locationName.size() <= 120))
        && (!('startsAt' in data) || (data.startsAt is string && data.startsAt.size() <= 64))
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 60
        && (!('isDemoData' in data) || data.isDemoData is bool)
        && data.moderationStatus in ['approved', 'flagged', 'hidden']
        && data.flaggedCount is int && data.flaggedCount >= 0 && data.flaggedCount <= 10000
        && (!('participantsCount' in data) || (data.participantsCount is int && data.participantsCount >= 0 && data.participantsCount <= 10000))
        && data.createdAt is timestamp;
    }

    function isValidAdminAuditLog(data) {
      return data.keys().hasAll(['adminId', 'action', 'targetType', 'targetId', 'details', 'createdAt'])
        && data.keys().hasOnly(['adminId', 'action', 'targetType', 'targetId', 'details', 'createdAt'])
        && isValidId(data.adminId)
        && data.adminId == request.auth.uid
        && data.action is string && data.action.size() >= 3 && data.action.size() <= 80
        && data.targetType is string && data.targetType.size() >= 2 && data.targetType.size() <= 40
        && data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128
        && data.details is string && data.details.size() >= 4 && data.details.size() <= 400
        && data.createdAt is timestamp;
    }

    // --- Collection Rules ---

    // Single-document startup connectivity probe (never listable)
    match /test/connection {
      allow get: if true;
    }

    // Admin registry (server/console managed only; non-enumerable)
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && isVerifiedUser() && (isOwner(adminUid) || isAdmin());
      allow list: if false;
      allow create, update, delete: if false;
    }

    // PII-isolated Student User Profiles
    match /users/{userId} {
      allow get: if isValidId(userId) && isVerifiedUser() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().role == existing().role
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'courseOrSubject', 'studyPreferences', 'accessibilityPreferences', 'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isVerifiedUser() && (isOwner(userId) || isAdmin());
    }

    // Verified Campus Locations (students/admins read; admins only mutate)
    match /locations/{locationId} {
      allow get: if isValidId(locationId) && isStudentOrAdmin();
      allow list: if isVerifiedUser();
      allow create: if isValidId(locationId)
        && isAdmin()
        && isValidLocation(incoming())
        && incoming().id == locationId
        && incoming().updatedAt == request.time;
      allow update: if isValidId(locationId)
        && isAdmin()
        && isValidLocation(incoming())
        && incoming().id == existing().id
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'accessLevel', 'description', 'accessibilityInfo',
          'accessibilityVerified', 'openingHoursNote', 'updatedAt'
        ]);
      allow delete: if isValidId(locationId) && isAdmin();
    }

    // CampusPulse QR Registry (verified students/admins get single code; admins manage)
    match /qrCodes/{codeId} {
      allow get: if isValidId(codeId) && isStudentOrAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(codeId)
        && isAdmin()
        && isValidQrCode(incoming())
        && incoming().id == codeId
        && exists(/databases/$(database)/documents/locations/$(incoming().locationId))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(codeId)
        && isAdmin()
        && isValidQrCode(incoming())
        && incoming().id == existing().id
        && incoming().locationId == existing().locationId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['locationName', 'active', 'updatedAt']);
      allow delete: if isValidId(codeId) && isAdmin();
    }

    // Non-PII Study Space Occupancy Summary
    match /studySpaceOccupancy/{locationId} {
      allow get: if isValidId(locationId) && isStudentOrAdmin();
      allow list: if isVerifiedUser();
      allow create: if isValidId(locationId)
        && isStudentOrAdmin()
        && isValidStudySpaceOccupancy(incoming())
        && incoming().locationId == locationId
        && incoming().updatedAt == request.time;
      allow update: if isValidId(locationId)
        && isStudentOrAdmin()
        && isValidStudySpaceOccupancy(incoming())
        && incoming().locationId == existing().locationId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'occupancy', 'activeCheckIns', 'lastReporterPseudonym', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // Individual Occupancy Reports (owner/admin only, immutable once submitted)
    match /occupancyReports/{reportId} {
      allow get: if isValidId(reportId) && isVerifiedUser() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(reportId)
        && isStudentOrAdmin()
        && isValidOccupancyReport(incoming())
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // QR Check-In Sessions (student owns session; terminal-locked once completed; admin override)
    match /checkIns/{sessionId} {
      allow get: if isValidId(sessionId) && isVerifiedUser() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(sessionId)
        && isStudentOrAdmin()
        && isValidCheckInSession(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'active'
        && incoming().checkedInAt == request.time
        && (!('checkedOutAt' in incoming()) || incoming().checkedOutAt == null);
      allow update: if isValidId(sessionId)
        && isStudentOrAdmin()
        && isValidCheckInSession(incoming())
        && incoming().userId == existing().userId
        && incoming().locationId == existing().locationId
        && incoming().locationName == existing().locationName
        && incoming().qrCodeId == existing().qrCodeId
        && incoming().checkedInAt == existing().checkedInAt
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'checkedOutAt'])) ||
          (
            existing().userId == request.auth.uid &&
            existing().status == 'active' &&
            incoming().status == 'completed' &&
            incoming().checkedOutAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'checkedOutAt'])
          )
        );
      allow delete: if isValidId(sessionId) && isVerifiedUser() && (isAdmin() || existing().userId == request.auth.uid);
    }

    // Facility Reports (student submits & edits only while Submitted; admin triages & resolves)
    match /facilityReports/{reportId} {
      allow get: if isValidId(reportId) && isVerifiedUser() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(reportId)
        && isStudentOrAdmin()
        && isValidFacilityReport(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'Submitted'
        && !('adminNotes' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(reportId)
        && isValidFacilityReport(incoming())
        && incoming().userId == existing().userId
        && incoming().locationId == existing().locationId
        && incoming().locationName == existing().locationName
        && incoming().category == existing().category
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNotes', 'updatedAt'])
          ) ||
          (
            isStudent() &&
            existing().userId == request.auth.uid &&
            existing().status == 'Submitted' &&
            incoming().status == 'Submitted' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['description', 'updatedAt'])
          )
        );
      allow delete: if isValidId(reportId)
        && isVerifiedUser()
        && (isAdmin() || (existing().userId == request.auth.uid && existing().status == 'Submitted'));
    }

    // Community Items (students create/flag/join; admins govern announcements & moderation)
    match /communityItems/{itemId} {
      allow get: if isValidId(itemId) && isStudentOrAdmin() && (
        existing().moderationStatus == 'approved' ||
        existing().authorId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isVerifiedUser() && (
        resource.data.moderationStatus == 'approved' ||
        resource.data.authorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isValidId(itemId)
        && isStudentOrAdmin()
        && isValidCommunityItem(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().moderationStatus == 'approved'
        && incoming().flaggedCount == 0
        && (!('participantsCount' in incoming()) || incoming().participantsCount == 0 || incoming().participantsCount == 1)
        && incoming().createdAt == request.time
        && (incoming().kind != 'announcement' || isAdmin());
      allow update: if isValidId(itemId)
        && isStudentOrAdmin()
        && isValidCommunityItem(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && (
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'body', 'locationId', 'locationName', 'startsAt',
              'moderationStatus', 'flaggedCount', 'participantsCount'
            ])
          ) ||
          // Action: Author edits own approved post content
          (
            existing().authorId == request.auth.uid &&
            existing().moderationStatus == 'approved' &&
            incoming().kind == existing().kind &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'body', 'locationId', 'locationName', 'startsAt'
            ])
          ) ||
          // Action: Student flags approved content
          (
            existing().moderationStatus == 'approved' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['flaggedCount', 'moderationStatus']) &&
            incoming().flaggedCount == existing().flaggedCount + 1 &&
            incoming().moderationStatus == 'flagged'
          ) ||
          // Action: Student joins or leaves approved study group / event
          (
            existing().moderationStatus == 'approved' &&
            existing().kind in ['event', 'study-group'] &&
            incoming().diff(existing()).affectedKeys().hasOnly(['participantsCount']) &&
            (
              'participantsCount' in existing()
                ? (incoming().participantsCount == existing().participantsCount + 1 || incoming().participantsCount == existing().participantsCount - 1)
                : incoming().participantsCount == 1
            )
          )
        );
      allow delete: if isValidId(itemId)
        && isVerifiedUser()
        && (isAdmin() || (existing().authorId == request.auth.uid && existing().moderationStatus == 'approved'));
    }

    // Immutable Admin Audit Logs (admin read/create only; never editable or deletable)
    match /adminAuditLogs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(logId) && isAdmin() && isValidAdminAuditLog(incoming()) && incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
