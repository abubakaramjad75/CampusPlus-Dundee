{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Server- or console-managed administrator registry entry mapping a verified Firebase UID to administrator privileges.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "minLength": 5, "maxLength": 160 },
        "grantedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "grantedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Student account profile with PII strictly isolated to the owning user and administrators.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "minLength": 5, "maxLength": 160 },
        "displayName": { "type": "string", "minLength": 2, "maxLength": 60 },
        "courseOrSubject": { "type": "string", "minLength": 0, "maxLength": 80 },
        "studyPreferences": { "type": "array", "description": "Max 8 string tags" },
        "accessibilityPreferences": { "type": "string", "minLength": 0, "maxLength": 200 },
        "role": { "type": "string", "enum": ["student"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt", "updatedAt"]
    },
    "CampusLocation": {
      "title": "CampusLocation",
      "description": "Verified University of Dundee City Campus building or study space managed by administrators.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-z0-9\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "accessLevel": {
          "type": "string",
          "enum": [
            "Public & Student Access",
            "Student & Staff Card Access",
            "Restricted / Research Access",
            "Event / Controlled Access"
          ]
        },
        "description": { "type": "string", "minLength": 10, "maxLength": 600 },
        "accessibilityInfo": { "type": "string", "minLength": 4, "maxLength": 500 },
        "accessibilityVerified": { "type": "boolean" },
        "openingHoursNote": { "type": "string", "minLength": 0, "maxLength": 200 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "accessLevel", "description", "accessibilityInfo", "accessibilityVerified", "updatedAt"]
    },
    "QrCodeRecord": {
      "title": "QrCodeRecord",
      "description": "CampusPulse QR check-in point registry managed strictly by administrators.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "locationId": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-z0-9\\-]+$" },
        "locationName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "locationId", "locationName", "active", "createdAt", "updatedAt"]
    },
    "StudySpaceOccupancy": {
      "title": "StudySpaceOccupancy",
      "description": "Non-PII aggregated community occupancy state for a City Campus study location.",
      "type": "object",
      "properties": {
        "locationId": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-z0-9\\-]+$" },
        "occupancy": { "type": "string", "enum": ["Low", "Medium", "Busy", "Unknown"] },
        "activeCheckIns": { "type": "number" },
        "lastReporterPseudonym": { "type": "string", "minLength": 2, "maxLength": 60 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["locationId", "occupancy", "activeCheckIns", "lastReporterPseudonym", "updatedAt"]
    },
    "OccupancyReport": {
      "title": "OccupancyReport",
      "description": "Individual student occupancy submission for a verified study location.",
      "type": "object",
      "properties": {
        "locationId": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-z0-9\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "level": { "type": "string", "enum": ["Low", "Medium", "Busy"] },
        "pseudonym": { "type": "string", "minLength": 2, "maxLength": 60 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["locationId", "userId", "level", "pseudonym", "createdAt"]
    },
    "CheckInSession": {
      "title": "CheckInSession",
      "description": "Voluntary CampusPulse QR check-in and check-out record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "locationId": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-z0-9\\-]+$" },
        "locationName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "qrCodeId": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": { "type": "string", "enum": ["active", "completed"] },
        "checkedInAt": { "type": "string", "format": "date-time" },
        "checkedOutAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "locationId", "locationName", "qrCodeId", "status", "checkedInAt"]
    },
    "FacilityReport": {
      "title": "FacilityReport",
      "description": "Campus facility issue submitted by a student and triaged by administrators.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "locationId": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-z0-9\\-]+$" },
        "locationName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "category": {
          "type": "string",
          "enum": [
            "Broken equipment",
            "Damaged furniture",
            "Faulty sockets",
            "Cleanliness concerns",
            "Accessibility obstacles",
            "Incorrect facility information"
          ]
        },
        "description": { "type": "string", "minLength": 10, "maxLength": 1000 },
        "status": { "type": "string", "enum": ["Submitted", "Under review", "Resolved", "Rejected"] },
        "adminNotes": { "type": "string", "minLength": 0, "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "locationId", "locationName", "category", "description", "status", "createdAt", "updatedAt"]
    },
    "CommunityItem": {
      "title": "CommunityItem",
      "description": "Student community event, study group, recommendation, or administrator announcement.",
      "type": "object",
      "properties": {
        "kind": { "type": "string", "enum": ["event", "announcement", "study-group", "recommendation"] },
        "title": { "type": "string", "minLength": 4, "maxLength": 120 },
        "body": { "type": "string", "minLength": 10, "maxLength": 800 },
        "locationId": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-z0-9\\-]+$" },
        "locationName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "startsAt": { "type": "string", "minLength": 1, "maxLength": 64 },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "minLength": 2, "maxLength": 60 },
        "isDemoData": { "type": "boolean" },
        "moderationStatus": { "type": "string", "enum": ["approved", "flagged", "hidden"] },
        "flaggedCount": { "type": "number" },
        "participantsCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["kind", "title", "body", "authorId", "authorName", "moderationStatus", "flaggedCount", "createdAt"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Immutable log of sensitive administrative actions.",
      "type": "object",
      "properties": {
        "adminId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "action": { "type": "string", "minLength": 3, "maxLength": 80 },
        "targetType": { "type": "string", "minLength": 2, "maxLength": 40 },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "details": { "type": "string", "minLength": 4, "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["adminId", "action", "targetType", "targetId", "details", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Server- and console-managed administrator registry."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profiles readable and writable only by the owning user or an admin."
    },
    "/locations/{locationId}": {
      "schema": { "$ref": "#/entities/CampusLocation" },
      "description": "Verified University of Dundee City Campus locations readable by verified students/admins and managed by admins."
    },
    "/qrCodes/{codeId}": {
      "schema": { "$ref": "#/entities/QrCodeRecord" },
      "description": "CampusPulse QR check-in registry readable by students/admins and managed strictly by admins."
    },
    "/studySpaceOccupancy/{locationId}": {
      "schema": { "$ref": "#/entities/StudySpaceOccupancy" },
      "description": "Non-PII study space occupancy summary accessible to verified students and admins."
    },
    "/occupancyReports/{reportId}": {
      "schema": { "$ref": "#/entities/OccupancyReport" },
      "description": "Individual student occupancy reports isolated to owner and admin."
    },
    "/checkIns/{sessionId}": {
      "schema": { "$ref": "#/entities/CheckInSession" },
      "description": "QR check-in and check-out sessions isolated to the owning student or admin."
    },
    "/facilityReports/{reportId}": {
      "schema": { "$ref": "#/entities/FacilityReport" },
      "description": "Campus facility reports isolated to reporter and admin."
    },
    "/communityItems/{itemId}": {
      "schema": { "$ref": "#/entities/CommunityItem" },
      "description": "Community events, study groups, recommendations, and admin announcements."
    },
    "/adminAuditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AdminAuditLog" },
      "description": "Immutable admin audit trail."
    }
  }
}
